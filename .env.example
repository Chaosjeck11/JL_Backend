# ── Datenbank ──────────────────────────────────────────────────────────────────
# Für lokale Entwicklung (ohne Docker): localhost
# Im Docker-Stack (docker compose): Hostname = "db" (Service-Name aus compose)
DATABASE_URL=postgresql://jl_user:POSTGRES_PASSWORD_HERE@db:5432/jl_db

# PostgreSQL-Zugangsdaten (müssen mit DATABASE_URL übereinstimmen)
POSTGRES_DB=jl_db
POSTGRES_USER=jl_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── JWT ────────────────────────────────────────────────────────────────────────
# Mindestens 32 zufällige Zeichen – generieren mit: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_STRING

# ── Seeder ─────────────────────────────────────────────────────────────────────
# Wird nur beim ersten "npm run seed" verwendet (erstellt admin@jl.local)
# Nach dem ersten Seeding kann dieser Wert geändert/entfernt werden
ADMIN_SEED_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── CORS ───────────────────────────────────────────────────────────────────────
# Kommagetrennte Liste erlaubter Frontend-Origins
# Für lokale Entwicklung weglassen (Standard: http://localhost:5173)
# Für Tauri-Desktop-App: ,tauri://localhost,https://tauri.localhost,http://localhost:1420
CORS_ORIGINS=https://your-manage.example.com,https://your-frontend.example.com
