generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  accessLevel Int      @default(0)
  members     Member[]
}

model Member {
  id                   Int       @id @default(autoincrement())
  firstname            String
  lastname             String
  birthday             DateTime?
  email                String    @unique
  passwordHash         String
  phone                String?
  address              String?
  roleId               Int
  avatarPath           String?
  active               Boolean   @default(true)
  inactiveSince        DateTime?
  joinedAt             DateTime  @default(now())
  u18                  Boolean   @default(false)
  bereitsMitglied      Boolean   @default(false)
  schuelerStudentAzubi Boolean   @default(false)
  berufstaetig         Boolean   @default(false)
  excludeFromBeitrag   Boolean   @default(false)

  role               Role               @relation(fields: [roleId], references: [id])
  transactions       Transaction[]
  mitgliedsbeitraege Mitgliedsbeitrag[]
  files              File[]
  attachments        MemberAttachment[]
}

model MemberAttachment {
  id         Int      @id @default(autoincrement())
  memberId   Int
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  filename   String
  storedName String   @unique
  mimeType   String
  size       Int
  uploadedAt DateTime @default(now())
}

// ── File manager ──────────────────────────────────────────────────────────────

model File {
  id          Int      @id @default(autoincrement())
  filename    String
  storedName  String   @unique
  mimeType    String
  size        Int
  path        String
  uploadedAt  DateTime @default(now())
  uploadedBy  Int
  description String?

  uploader Member @relation(fields: [uploadedBy], references: [id])
}

// ── Finance module ────────────────────────────────────────────────────────────

enum TransactionType {
  EINZAHLUNG
  AUSZAHLUNG
  RUECKBUCHUNG
}

enum BeitragStatus {
  AUSSTEHEND
  TEILWEISE
  BEZAHLT
}

enum PaymentTag {
  ONLINE
  BAR
}

model BusinessYear {
  id                 Int                @id @default(autoincrement())
  year               Int                @unique
  carryOver          Float              @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  transactions       Transaction[]
  mitgliedsbeitraege Mitgliedsbeitrag[]
}

model Category {
  id                 Int           @id @default(autoincrement())
  name               String        @unique
  description        String?
  isMitgliedsbeitrag Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  transactions       Transaction[]
}

model Transaction {
  id                   Int             @id @default(autoincrement())
  date                 DateTime
  description          String
  type                 TransactionType
  amount               Float
  categoryId           Int
  businessYearId       Int
  memberId             Int?
  relatedTransactionId Int?
  tag                  PaymentTag?
  veranstaltungId      Int?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  category           Category                @relation(fields: [categoryId], references: [id])
  businessYear       BusinessYear            @relation(fields: [businessYearId], references: [id])
  member             Member?                 @relation(fields: [memberId], references: [id])
  relatedTransaction Transaction?            @relation("Rueckbuchung", fields: [relatedTransactionId], references: [id])
  reversals          Transaction[]           @relation("Rueckbuchung")
  attachments        TransactionAttachment[]
  veranstaltung      Veranstaltung?          @relation(fields: [veranstaltungId], references: [id])
}

model TransactionAttachment {
  id            Int         @id @default(autoincrement())
  transactionId Int
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  filename      String
  storedName    String      @unique
  mimeType      String
  size          Int
  uploadedAt    DateTime    @default(now())
}

// ── Veranstaltungen module ────────────────────────────────────────────────────

model Veranstaltung {
  id          Int      @id @default(autoincrement())
  name        String
  date        DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions Transaction[]
  attachments  VeranstaltungAttachment[]
  form         VeranstaltungForm?
  kategorien   VeranstaltungKategorie[]
}

model VeranstaltungKategorie {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  veranstaltungen Veranstaltung[]
}

model VeranstaltungAttachment {
  id              Int           @id @default(autoincrement())
  veranstaltungId Int
  veranstaltung   Veranstaltung @relation(fields: [veranstaltungId], references: [id], onDelete: Cascade)
  filename        String
  storedName      String        @unique
  mimeType        String
  size            Int
  uploadedAt      DateTime      @default(now())
}

model VeranstaltungFormTemplate {
  id        Int      @id @default(autoincrement())
  columns   Json     @default("[]")
  updatedAt DateTime @updatedAt
}

model VeranstaltungForm {
  id              Int           @id @default(autoincrement())
  veranstaltungId Int           @unique
  veranstaltung   Veranstaltung @relation(fields: [veranstaltungId], references: [id], onDelete: Cascade)
  columns         Json          @default("[]")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  rows VeranstaltungFormRow[]
}

model VeranstaltungFormRow {
  id        Int               @id @default(autoincrement())
  formId    Int
  form      VeranstaltungForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  rowIndex  Int
  cells     Json              @default("{}")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model Mitgliedsbeitrag {
  id             Int           @id @default(autoincrement())
  memberId       Int
  businessYearId Int
  betragJL       Float
  betragKG       Float
  bezahltJL      Float         @default(0)
  bezahltKG      Float         @default(0)
  status         BeitragStatus @default(AUSSTEHEND)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  member       Member       @relation(fields: [memberId], references: [id])
  businessYear BusinessYear @relation(fields: [businessYearId], references: [id])

  @@unique([memberId, businessYearId])
}
