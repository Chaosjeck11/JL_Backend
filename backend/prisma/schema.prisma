generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  members     Member[]
}

model Member {
  id           Int      @id @default(autoincrement())
  firstname    String
  lastname     String
  birthday     DateTime?
  email        String   @unique

  passwordHash String

  phone        String?
  address      String?
  roleId       Int
  accessLevel  Int      @default(0)
  avatarPath   String?
  active       Boolean  @default(true)
  joinedAt     DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id])
}

