# Database
DATABASE_URL=postgresql://jl_user:CHANGE_ME@localhost:5432/jl_db

# JWT — must be at least 32 random characters
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_STRING

# Admin seed password — used only when running: npm run seed
ADMIN_SEED_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# CORS — comma-separated list of allowed frontend origins
# For local dev you can leave this unset (defaults to localhost:5173)
CORS_ORIGINS=https://your-frontend.example.com,https://your-manage.example.com

# Tauri desktop app origins (add if you use the Tauri frontend)
# CORS_ORIGINS=https://your-frontend.example.com,tauri://localhost,https://tauri.localhost,http://localhost:1420
